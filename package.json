{
  "name": "@local/dsh-todo-watch",
  "version": "2.1.4",
  "private": true,
  "type": "module",
  "description": "Сторож TODO для DSH: каждые 30 секунд проверяет плашку задач над полем ввода, сам создаёт и обновляет список в живых сессиях, а в левом сайдбаре показывает журнал последних подсказок.",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:host": "tsc -p tsconfig.json",
    "build:host:min": "node scripts/minify-host.mjs",
    "build:host:fix": "node scripts/fix-imports.mjs",
    "build": "npm run clean && npm run build:host && npm run build:host:min && npm run build:host:fix && npm run build:client",
    "test": "npm run typecheck && rm -rf dist.test && tsc -p tsconfig.test.json && node --test dist.test/src/test/*.test.js",
    "build:client:tsc": "tsc -p tsconfig.client.json",
    "build:client": "npm run build:client:tsc && node scripts/build-client.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "terser": "^5.36.0",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
